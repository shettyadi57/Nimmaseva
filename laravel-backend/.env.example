APP_NAME="Nimma Seva"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nimmaseva
DB_USERNAME=nimmaseva
DB_PASSWORD=nimmaseva_secret

CACHE_STORE=redis
CACHE_PREFIX=nimmaseva_

QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@nimmaseva.in"
MAIL_FROM_NAME="Nimma Seva Karnataka"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000

# CORS — allow the Vite frontend
FRONTEND_URL=http://localhost:5173

# Laravel Reverb (WebSocket)
REVERB_APP_ID=nimmaseva
REVERB_APP_KEY=nimmaseva_reverb_key
REVERB_APP_SECRET=nimmaseva_reverb_secret
REVERB_HOST=0.0.0.0
REVERB_PORT=6001
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# MSG91 (SMS/WhatsApp — Step 3, toggled)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=NMMSVA
MSG91_TEMPLATE_CONFIRM=
MSG91_TEMPLATE_REMINDER=
MSG91_TEMPLATE_CANCEL=

# Razorpay (Step 3 payments — toggled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Feature Flags
FEATURE_PAYMENTS=false
FEATURE_SMS=false
FEATURE_WHATSAPP=false
FEATURE_DOCUMENT_UPLOAD=false

# Rate limits (requests per minute)
RATE_LIMIT_AUTH=10
RATE_LIMIT_BOOKING=30
RATE_LIMIT_OTP=5
